# FoodCue Environment Variables Template (.env.example)
# FoodCue is a local-first PWA. A Neon database URL can be provided for optional cloud backup and sync.

VITE_APP_NAME="FoodCue"
VITE_APP_TAGLINE="Know your food. Manage your kitchen."

# Neon Lakebase Postgres Connection URL (Optional - leave empty for 100% offline local-only)
VITE_NEON_DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-snowy-mode-b3jn52y5-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# OpenRouter API Key (Optional AI Assist / OCR Fallback)
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key-here"
VITE_OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key-here"

# Groq API Key (Optional High-speed Voice Intake & Regex Processing)
GROQ_API_KEY="gsk_your-groq-key-here"
VITE_GROQ_API_KEY="gsk_your-groq-key-here"

# Feature Toggles
VITE_ENABLE_NEON_SYNC="true"
VITE_OPENFOODFACTS_LOOKUP="false"
