# FoodCue Environment Variables Template (.env.example)
# FoodCue is a local-first packaged food intelligence & kitchen management PWA.
# Cloud synchronization with Neon PostgreSQL and Clerk is strictly optional.

# Application Identity
VITE_APP_NAME="FoodCue"
VITE_APP_TAGLINE="Know your food. Manage your kitchen."

# Frontend - Public Clerk Configuration
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Backend - Private Clerk Configuration (Server-Only, Never exposed to browser)
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Neon PostgreSQL - Pooled (Serverless HTTP / Edge Functions / Runtime Queries)
DATABASE_URL=postgresql://neondb_owner:REPLACE_ME@ep-snowy-mode-b3jn52y5-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
VITE_NEON_DATABASE_URL=postgresql://neondb_owner:REPLACE_ME@ep-snowy-mode-b3jn52y5-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon PostgreSQL - Direct / Unpooled (Migrations & DDL)
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:REPLACE_ME@ep-snowy-mode-b3jn52y5.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
NEON_DATABASE_URL_UNPOOLED=postgresql://neondb_owner:REPLACE_ME@ep-snowy-mode-b3jn52y5.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Clerk Webhook Signing Secret — Prepared for Phase 5 (Do NOT fabricate; configure after dashboard creation)
CLERK_WEBHOOK_SIGNING_SECRET=

# Optional Assistive Intelligence Endpoints
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
GROQ_API_KEY=gsk_REPLACE_ME
TAVILY_API_KEY=tvly-dev-REPLACE_ME
VITE_TAVILY_API_KEY=tvly-dev-REPLACE_ME

# Feature Toggles
VITE_ENABLE_NEON_SYNC="true"
VITE_OPENFOODFACTS_LOOKUP="false"
