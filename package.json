{
  "name": "foodcue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/bundle-api.mjs",
    "build:api": "node scripts/bundle-api.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "db:migrate": "node scripts/run-migrations.mjs",
    "security:audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@clerk/backend": "3.29.0",
    "@clerk/react": "6.18.8",
    "@neondatabase/serverless": "1.2.1",
    "@sec-ant/zxing-wasm": "2.2.0",
    "@vitejs/plugin-react": "4.3.4",
    "lucide-react": "1.73.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "26.6.6",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "eslint": "9.17.0",
    "fake-indexeddb": "6.2.8",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "typescript-eslint": "8.19.1",
    "vitest": "2.1.8"
  }
}
